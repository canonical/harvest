groups:
  - name: harvest-server
    rules:
      - alert: HarvestUnitNotReady
        expr: harvest_ready == 0
        for: 2m
        labels:
          severity: warning
        annotations:
          summary: Harvest unit {{ $labels.juju_unit }} is not ready
      - alert: HarvestDatabaseDown
        expr: harvest_database_up == 0
        for: 1m
        labels:
          severity: critical
        annotations:
          summary: Harvest unit {{ $labels.juju_unit }} cannot reach PostgreSQL
      - alert: HarvestBusDisconnected
        expr: harvest_bus_listening == 0
        for: 1m
        labels:
          severity: warning
        annotations:
          summary: Harvest unit {{ $labels.juju_unit }} lost its cluster event bus listener
