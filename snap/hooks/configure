#!/bin/bash
set -eu

if [ "$(snapctl get config.managed)" = "true" ]; then
  exit 0
fi

_DATABASE_URL=$(snapctl get database.url)
_JWT_SECRET=$(snapctl get auth.jwt-secret)

if [ -f "$SNAP_COMMON/server.toml" ]; then
  _errors=""
  [ -z "$_DATABASE_URL" ] && _errors="${_errors}  database.url is required\n"
  [ -z "$_JWT_SECRET" ]   && _errors="${_errors}  auth.jwt-secret is required\n"
  if [ -n "$_errors" ]; then
    printf "harvest: missing required configuration:\n%b\nRun: snap set harvest database.url=postgres://user:pw@host:5432/harvest auth.jwt-secret=\$(openssl rand -base64 32)\n" "$_errors" >&2
    exit 1
  fi
fi

DATABASE_URL="$_DATABASE_URL"
DATABASE_POOL_SIZE=$(snapctl get database.pool-size)
DATABASE_CA_FILE=$(snapctl get database.ca-file)
SERVER_HOST=$(snapctl get server.host)
SERVER_PORT=$(snapctl get server.port)

CLUSTER_INTERNAL_LISTEN=$(snapctl get cluster.internal-listen)
CLUSTER_INTERNAL_URL=$(snapctl get cluster.internal-url)
CLUSTER_SHARED_SECRET=$(snapctl get cluster.shared-secret)
CLUSTER_NODE_NAME=$(snapctl get cluster.node-name)

AGENT_MAX_ITER=$(snapctl get agent.max-iterations)
AGENT_COMPACT_CHARS=$(snapctl get agent.compaction-threshold-chars)
AGENT_COMPACT_KEEP=$(snapctl get agent.compaction-keep-last)

JWT_SECRET="$_JWT_SECRET"
AUTH_LOCAL_LOGIN=$(snapctl get auth.allow-local-login)
AUTH_PUBLIC_URL=$(snapctl get auth.public-url)
GOOGLE_CLIENT_ID=$(snapctl get auth.google.client-id)
GOOGLE_CLIENT_SECRET=$(snapctl get auth.google.client-secret)
GOOGLE_REDIRECT_URI=$(snapctl get auth.google.redirect-uri)
OIDC_ISSUER_URL=$(snapctl get auth.oidc.issuer-url)
OIDC_CLIENT_ID=$(snapctl get auth.oidc.client-id)
OIDC_CLIENT_SECRET=$(snapctl get auth.oidc.client-secret)
OIDC_REDIRECT_URI=$(snapctl get auth.oidc.redirect-uri)
OIDC_DISPLAY_NAME=$(snapctl get auth.oidc.display-name)
USER_KEY_ENCRYPTION_KEY=$(snapctl get security.user-key-encryption-key)

AGENTS_PUBLIC_URL=$(snapctl get agents.public-url)
DOCS_DIR=$(snapctl get docs.dir)
UI_ENABLE_DOCS=$(snapctl get ui.enable-docs)
LOG_LEVEL=$(snapctl get log.level)

LXD_ENDPOINT=$(snapctl get lxd.endpoint)
LXD_CLIENT_CERT=$(snapctl get lxd.client-cert)
LXD_CLIENT_KEY=$(snapctl get lxd.client-key)
LXD_TRUST_TOKEN=$(snapctl get lxd.trust-token)
LXD_CA_CERT=$(snapctl get lxd.ca-cert)
LXD_INSECURE=$(snapctl get lxd.insecure)
LXD_PROJECT=$(snapctl get lxd.project)
LXD_IMAGE_ALIAS=$(snapctl get lxd.image-alias)
LXD_IMAGE_SERVER=$(snapctl get lxd.image-server)
LXD_PROFILE=$(snapctl get lxd.profile)

: "${SERVER_HOST:=127.0.0.1}"
: "${SERVER_PORT:=8080}"
: "${DATABASE_POOL_SIZE:=16}"
: "${AGENT_MAX_ITER:=20}"
: "${AGENT_COMPACT_CHARS:=40000}"
: "${AGENT_COMPACT_KEEP:=6}"
: "${AUTH_LOCAL_LOGIN:=true}"
: "${DOCS_DIR:=$SNAP_COMMON/docs}"
: "${UI_ENABLE_DOCS:=false}"
: "${LOG_LEVEL:=warn}"

mkdir -p "$SNAP_COMMON" "$DOCS_DIR"

printf 'RUST_LOG=%s\n' "$LOG_LEVEL" > "$SNAP_COMMON/env"

generate_llm_blocks() {
  local llm_json
  llm_json=$(snapctl get -d llm 2>/dev/null || echo '{}')
  LLM_JSON="$llm_json" python3 -c '
import json, os, sys

DEFAULTS = {
    "anthropic":         "claude-sonnet-4-6",
    "gemini":            "gemini-2.5-flash",
    "openai-compatible": "",
}

try:
    data = json.loads(os.environ.get("LLM_JSON", "{}"))
except Exception:
    data = {}

if not isinstance(data, dict):
    data = {}

providers = data.get("llm", data)
if not isinstance(providers, dict):
    providers = {}

def sort_key(kv):
    _, cfg = kv
    if not isinstance(cfg, dict):
        return (999, kv[0])
    try:
        return (int(str(cfg.get("priority", 0))), kv[0])
    except (ValueError, TypeError):
        return (0, kv[0])

found = 0
for name, cfg in sorted(providers.items(), key=sort_key):
    if not isinstance(cfg, dict):
        continue
    api_key = cfg.get("api-key", "")
    if not api_key:
        continue
    provider     = cfg.get("provider", "anthropic")
    model        = cfg.get("model", "") or DEFAULTS.get(provider, "")
    timeout      = cfg.get("timeout-secs", 120)
    retries      = cfg.get("max-retries", 3)
    priority     = cfg.get("priority", 0)
    base_url     = cfg.get("base-url", "")
    expose_to_ui = str(cfg.get("expose-to-ui", "true")).strip().lower() not in ("false", "0", "no", "")
    display_name = cfg.get("display-name", "")
    models       = [m.strip() for m in str(cfg.get("models", "")).split(",") if m.strip()]

    print("")
    print("[[llm]]")
    print("provider     = \"%s\"" % provider)
    print("api_key      = \"%s\"" % api_key)
    if model:
        print("model        = \"%s\"" % model)
    print("timeout_secs = %s" % timeout)
    print("max_retries  = %s" % retries)
    print("priority     = %s" % priority)
    if provider == "openai-compatible" and base_url:
        print("base_url     = \"%s\"" % base_url)
    print("id           = \"%s\"" % name)
    print("expose_to_ui = %s" % ("true" if expose_to_ui else "false"))
    if display_name:
        print("name         = \"%s\"" % display_name)
    if models:
        print("models       = [%s]" % ", ".join("\"%s\"" % m for m in models))
    found += 1
'
}

{
  cat << TOML
[server]
host = "${SERVER_HOST}"
port = ${SERVER_PORT}

[database]
url = "${DATABASE_URL}"
pool_size = ${DATABASE_POOL_SIZE}
TOML
  [ -n "${DATABASE_CA_FILE:-}" ] && echo "ca_file = \"${DATABASE_CA_FILE}\""

  if [ -n "${CLUSTER_INTERNAL_LISTEN:-}" ]; then
    cat << TOML

[cluster]
internal_listen = "${CLUSTER_INTERNAL_LISTEN}"
TOML
    [ -n "${CLUSTER_INTERNAL_URL:-}" ]  && echo "internal_url = \"${CLUSTER_INTERNAL_URL}\""
    [ -n "${CLUSTER_SHARED_SECRET:-}" ] && echo "shared_secret = \"${CLUSTER_SHARED_SECRET}\""
    [ -n "${CLUSTER_NODE_NAME:-}" ]     && echo "node_name = \"${CLUSTER_NODE_NAME}\""
  fi

  llm_blocks=$(generate_llm_blocks)
  if [ -n "$llm_blocks" ]; then
    echo "$llm_blocks"
  else
    echo ""
    echo "llm = []"
  fi

  cat << TOML

[agent]
max_iterations             = ${AGENT_MAX_ITER}
compaction_threshold_chars = ${AGENT_COMPACT_CHARS}
compaction_keep_last       = ${AGENT_COMPACT_KEEP}

[auth]
jwt_secret        = "${JWT_SECRET}"
allow_local_login = ${AUTH_LOCAL_LOGIN}
TOML
  [ -n "${AUTH_PUBLIC_URL:-}" ] && echo "public_url        = \"${AUTH_PUBLIC_URL}\""

  if [ -n "${GOOGLE_CLIENT_ID:-}" ] && \
     [ -n "${GOOGLE_CLIENT_SECRET:-}" ] && \
     [ -n "${GOOGLE_REDIRECT_URI:-}" ]; then
    cat << TOML

[auth.google]
client_id     = "${GOOGLE_CLIENT_ID}"
client_secret = "${GOOGLE_CLIENT_SECRET}"
redirect_uri  = "${GOOGLE_REDIRECT_URI}"
TOML
  fi

  if [ -n "${OIDC_ISSUER_URL:-}" ] && \
     [ -n "${OIDC_CLIENT_ID:-}" ] && \
     [ -n "${OIDC_CLIENT_SECRET:-}" ] && \
     [ -n "${OIDC_REDIRECT_URI:-}" ]; then
    cat << TOML

[auth.oidc]
issuer_url    = "${OIDC_ISSUER_URL}"
client_id     = "${OIDC_CLIENT_ID}"
client_secret = "${OIDC_CLIENT_SECRET}"
redirect_uri  = "${OIDC_REDIRECT_URI}"
TOML
    if [ -n "${OIDC_DISPLAY_NAME:-}" ]; then
      echo "display_name  = \"${OIDC_DISPLAY_NAME}\""
    fi
  fi

  if [ -n "${USER_KEY_ENCRYPTION_KEY:-}" ]; then
    cat << TOML

[security]
user_key_encryption_key = "${USER_KEY_ENCRYPTION_KEY}"
TOML
  fi

  cat << TOML

[agents]
binary_path = "${SNAP}/bin/harvest-agent"
TOML

  if [ -n "${AGENTS_PUBLIC_URL:-}" ]; then
    echo "public_url  = \"${AGENTS_PUBLIC_URL}\""
  fi

  cat << TOML

[documentation]
docs_dir = "${DOCS_DIR}"

[ui]
enable_docs = ${UI_ENABLE_DOCS}
TOML

  if [ -n "${LXD_ENDPOINT:-}" ]; then
    cat << TOML

[lxd]
endpoint    = "${LXD_ENDPOINT}"
TOML
    if [ -n "${LXD_CLIENT_CERT:-}" ] && [ -n "${LXD_CLIENT_KEY:-}" ]; then
      cat << TOML
client_cert = """
${LXD_CLIENT_CERT}
"""
client_key  = """
${LXD_CLIENT_KEY}
"""
TOML
    elif [ -n "${LXD_TRUST_TOKEN:-}" ]; then
      echo "trust_token = \"${LXD_TRUST_TOKEN}\""
    fi
    if [ -n "${LXD_CA_CERT:-}" ]; then
      cat << TOML
ca_cert = """
${LXD_CA_CERT}
"""
TOML
    fi
    [ -n "${LXD_INSECURE:-}" ]     && echo "insecure     = ${LXD_INSECURE}"
    [ -n "${LXD_PROJECT:-}" ]      && echo "project      = \"${LXD_PROJECT}\""
    [ -n "${LXD_IMAGE_ALIAS:-}" ]  && echo "image_alias  = \"${LXD_IMAGE_ALIAS}\""
    [ -n "${LXD_IMAGE_SERVER:-}" ] && echo "image_server = \"${LXD_IMAGE_SERVER}\""
    [ -n "${LXD_PROFILE:-}" ]      && echo "profile      = \"${LXD_PROFILE}\""
  fi
  true
} > "$SNAP_COMMON/server.toml"

snapctl restart harvest.server 2>/dev/null || true
snapctl restart harvest.ui   2>/dev/null || true

generate_harvester_llm_block() {
  local llm_json
  llm_json=$(snapctl get -d llm 2>/dev/null || echo '{}')
  LLM_JSON="$llm_json" python3 -c '
import json, os, sys

DEFAULTS = {
    "anthropic":         "claude-sonnet-4-6",
    "gemini":            "gemini-2.5-flash",
    "openai-compatible": "",
}

try:
    data = json.loads(os.environ.get("LLM_JSON", "{}"))
except Exception:
    data = {}

providers = data.get("llm", data) if isinstance(data, dict) else {}
if not isinstance(providers, dict):
    providers = {}

def sort_key(kv):
    _, cfg = kv
    if not isinstance(cfg, dict):
        return (999, kv[0])
    try:
        return (int(str(cfg.get("priority", 0))), kv[0])
    except (ValueError, TypeError):
        return (0, kv[0])

for name, cfg in sorted(providers.items(), key=sort_key):
    if not isinstance(cfg, dict):
        continue
    api_key = cfg.get("api-key", "")
    if not api_key:
        continue
    provider = cfg.get("provider", "anthropic")
    model    = cfg.get("model", "") or DEFAULTS.get(provider, "")
    timeout  = cfg.get("timeout-secs", 120)
    retries  = cfg.get("max-retries", 3)
    base_url = cfg.get("base-url", "")

    print("")
    print("[llm]")
    print("provider     = \"%s\"" % provider)
    print("api_key      = \"%s\"" % api_key)
    if model:
        print("model        = \"%s\"" % model)
    print("timeout_secs = %s" % timeout)
    print("max_retries  = %s" % retries)
    if provider == "openai-compatible" and base_url:
        print("base_url     = \"%s\"" % base_url)
    break  # single provider only
'
}

{
  cat << TOML
[database]
url = "${DATABASE_URL}"
TOML

  generate_harvester_llm_block

} > "$SNAP_COMMON/harvester.toml"
