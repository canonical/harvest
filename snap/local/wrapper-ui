#!/bin/bash
set -eu

UI_HOST=$(snapctl get ui.host)
UI_PORT=$(snapctl get ui.port)
UI_MODE=$(snapctl get ui.mode)
SERVER_HOST=$(snapctl get server.host)
SERVER_PORT=$(snapctl get server.port)

: "${UI_HOST:=127.0.0.1}"
: "${UI_PORT:=3000}"
: "${UI_MODE:=proxy}"
: "${SERVER_HOST:=127.0.0.1}"
: "${SERVER_PORT:=8080}"

export XDG_DATA_HOME="$SNAP_COMMON"
export XDG_CONFIG_HOME="$SNAP_COMMON"
export XDG_CACHE_HOME="$SNAP_COMMON"

ASSET_ROOT="$SNAP_COMMON/ui-assets"
mkdir -p "$ASSET_ROOT/assets"
if [ -d "$SNAP/share/harvest-ui/assets" ]; then
  cp -r --update=none "$SNAP/share/harvest-ui/assets/." "$ASSET_ROOT/assets/"
  (cd "$SNAP/share/harvest-ui/assets" && find . -type f -exec touch "$ASSET_ROOT/assets/{}" \;)
  find "$ASSET_ROOT/assets" -type f -mtime +30 -delete 2>/dev/null || true
fi

API_BLOCK=""
if [ "$UI_MODE" != "static" ]; then
  API_BLOCK="	@api path_regexp ^/(auth|admin|conversations|groups|projects|query|repositories|graph|health|version|metrics|tool-description|docs|skills|agents|agent|llm|artifacts|templates|chat-layouts|machines)(/|\$)

	handle @api {
		reverse_proxy ${SERVER_HOST}:${SERVER_PORT} {
			header_up Host       {host}
			header_up X-Real-IP  {remote_host}
			flush_interval -1
			transport http {
				read_timeout  3600s
				write_timeout 3600s
			}
		}
	}"
fi

cat > "$SNAP_COMMON/Caddyfile" << CADDY
{
	auto_https     off
	admin          off
	persist_config off
}

${UI_HOST}:${UI_PORT} {
${API_BLOCK}

	handle /ui-health {
		respond "ok" 200
	}

	handle /assets/* {
		root * ${ASSET_ROOT}
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	handle {
		root * ${SNAP}/share/harvest-ui
		header Cache-Control "no-cache"
		try_files {path} {path}/ /index.html
		file_server
	}
}
CADDY

echo "Harvest UI on http://${UI_HOST}:${UI_PORT} (${UI_MODE} mode)"
exec "${CADDY_BIN:-$SNAP/bin/caddy}" run --config "$SNAP_COMMON/Caddyfile"
