#!/bin/bash
set -eu

CONF="$SNAP_COMMON/server.toml"

if [ ! -f "$CONF" ]; then
  echo "error: harvest is not configured." >&2
  echo "  snap set harvest database.url=postgres://user:pw@host:5432/harvest llm.main.provider=gemini llm.main.api-key=<key> auth.jwt-secret=<secret>" >&2
  exit 1
fi

[ -f "$SNAP_COMMON/env" ] && . "$SNAP_COMMON/env"

exec "$SNAP/bin/knowledge-server" --config "$CONF" "$@"
